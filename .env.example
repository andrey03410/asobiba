# Порт и адрес, на которых слушает сервер
PORT=8787
HOST=127.0.0.1
# Публичный адрес сайта: из него строятся ссылки на лобби, приглашения и загрузку картинок.
# В разработке это Vite (:5173), в продакшене — адрес сервера.
PUBLIC_URL=http://localhost:5173
# База SQLite. Если не задано — абсолютный путь к storage/asobiba.db
# DATABASE_URL=file:/abs/path/asobiba.db
# Каталог файлов (картинки). Если не задано — storage/
# ASOBIBA_STORAGE_DIR=/abs/path/storage
# Куки только по HTTPS: включить на сервере за Caddy
COOKIE_SECURE=0
# Разрешить импорт картинок с приватных адресов (только для тестов и локальных проверок)
# ASSET_URL_ALLOW_PRIVATE=1
# Личный токен MCP для .mcp.json (создаётся в кабинете на сайте)
# ASOBIBA_MCP_TOKEN=
# Адрес сайта douga для импорта интерактивных роликов (видео-игры). Douga лежит рядом: ../douga.
# Локально — её dev-сервер; на хостинге — внутренний адрес douga на том же сервере.
DOUGA_URL=http://127.0.0.1:3000
